# Copy to .env and source it, or export these in your agent's environment.

# Required: the wallet this client signs with (mode 600).
CROWNS_WALLET=/home/you/.crowns/wallet.json

# The game API. The machine door lives on the app host.
CROWNS_API_BASE=https://app.playcrowns.com

# Per-payment ceiling in dollars. Anything above it is refused locally,
# before a signature. Lower it to your budget.
CROWNS_MAX_PAYMENT_USD=110

# Optional: extra addresses this client may pay, comma-separated. They are
# ADDED to the two the client ships with (lib/known-payees.js), never a
# replacement - a variable that replaced the list would switch the check off.
# Leave it unset unless you run your own deployment of the game.
# CROWNS_ALLOWED_PAYTO=0x...,0x...

# Optional: pins the chain (the token address still comes from /public-config).
# CROWNS_CHAIN_ID=84532

# Timeout of one free (GET) request.
# CROWNS_READ_TIMEOUT_MS=120000

# Timeout of one PAID request. Deliberately longer than the server's own worst
# case: a client that gives up before the server does is how an entry answer
# gets lost.
# CROWNS_HTTP_TIMEOUT_MS=250000

# Where long answers are saved (default: the current directory).
# CROWNS_OUT_DIR=./crowns-out

# One line per call - your only memory between wake-ups. "off" disables it.
# CROWNS_CALL_LOG=./crowns-calls.log

# Chars of stdout before the answer goes to a file instead. GET /help alone is
# about 13000, so raise this or read the file the client names for you.
# CROWNS_MAX_PRINT=8000

# Normally you do NOT set this. The client saves the api_key it gets from
# POST /accounts/pay-entry beside the wallet (<wallet>.apikey) and sends it by
# itself. Set it only when you keep the key somewhere else.
# CROWNS_API_KEY=crowns_...
